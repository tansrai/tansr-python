{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sdk2-cache-core-v1 additive contract",
  "description": "旧cache-v1不变。跨字段检查：有效source/binding revision非0；coverage正序且三字段同null；签名时窗≤300000ms；原header≤8192bytes、decoded≤6144bytes；诊断row≤4096bytes。",
  "oneOf": [
    {
      "$ref": "#/definitions/Proof"
    },
    {
      "$ref": "#/definitions/Capabilities"
    },
    {
      "$ref": "#/definitions/Diagnostics"
    },
    {
      "$ref": "#/definitions/Lookup"
    }
  ],
  "definitions": {
    "Lookup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "state", "result"],
      "description": "独立lookup入口，完整UTF-8响应≤1048576bytes；非completed的result必须null；任何状态不授权首次执行或清pending。",
      "properties": {
        "protocol": { "const": "sdk2-cache-core-v1" },
        "state": { "enum": ["not-found", "accepted", "result-unknown", "completed", "receipt-expired"] },
        "result": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["status", "contentType", "body"],
              "properties": {
                "status": { "type": "integer", "minimum": 100, "maximum": 599 },
                "contentType": { "type": "string", "minLength": 1, "maxLength": 128 },
                "body": { "type": "string", "maxLength": 262144, "description": "运行时另核UTF-8≤262144bytes，原响应正文不重编码。" },
                "headers": { "type": "object", "additionalProperties": false, "properties": {
                  "cost": { "type": "string", "maxLength": 1024 },
                  "balance": { "type": "string", "maxLength": 1024 },
                  "priceTable": { "type": "string", "maxLength": 1024 }
                } }
              }
            }
          ]
        }
      },
      "if": { "properties": { "state": { "not": { "const": "completed" } } } },
      "then": { "properties": { "result": { "type": "null" } } }
    },
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$"
    },
    "LegacyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "Sequence": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "十进制序列 < 9223372036854775807，运行时检查上界。"
    },
    "Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromSequence",
        "throughSequence",
        "headDigest"
      ],
      "properties": {
        "fromSequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "十进制序列 < 9223372036854775807，运行时检查上界。"
        },
        "throughSequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "十进制序列 < 9223372036854775807，运行时检查上界。"
        },
        "headDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "Material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "source",
        "coverage",
        "assemblerVersion",
        "sourceHeadDigest"
      ],
      "properties": {
        "format": {
          "const": "sdk2-governance-material-v1"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceId",
            "sourceGeneration",
            "snapshotDigest",
            "generations"
          ],
          "properties": {
            "sourceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$"
            },
            "sourceGeneration": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "snapshotDigest": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "generations": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "historyEpoch",
                "deletionGeneration",
                "projectionRevision"
              ],
              "properties": {
                "historyEpoch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "deletionGeneration": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,18})$",
                  "description": "十进制序列 < 9223372036854775807，运行时检查上界。"
                },
                "projectionRevision": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,18})$",
                  "description": "十进制序列 < 9223372036854775807，运行时检查上界。"
                }
              }
            }
          }
        },
        "coverage": {
          "anyOf": [
            {
              "$ref": "#/definitions/Coverage"
            },
            {
              "type": "null"
            }
          ]
        },
        "assemblerVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceHeadDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assemblerVersion",
        "effectiveInput",
        "materials"
      ],
      "properties": {
        "assemblerVersion": {
          "const": "tansr-core-request-v1"
        },
        "effectiveInput": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "systemSha256",
            "toolsSha256"
          ],
          "properties": {
            "systemSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "toolsSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "materials": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/definitions/Material"
          }
        }
      }
    },
    "Intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationScopeId",
        "endUserId",
        "sourceNamespace",
        "sourceId",
        "sourceRevision",
        "deletionGeneration",
        "history",
        "runtimeSessionId",
        "bindingId",
        "bindingRevision",
        "projectionRef",
        "requestId",
        "payloadSha256",
        "core"
      ],
      "properties": {
        "applicationScopeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$"
        },
        "endUserId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sourceNamespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "十进制序列 < 9223372036854775807，运行时检查上界。"
        },
        "deletionGeneration": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "十进制序列 < 9223372036854775807，运行时检查上界。"
        },
        "history": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generation",
            "commit"
          ],
          "properties": {
            "generation": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,18})$",
              "description": "十进制序列 < 9223372036854775807，运行时检查上界。"
            },
            "commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "runtimeSessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "bindingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$"
        },
        "bindingRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$",
          "description": "十进制序列 < 9223372036854775807，运行时检查上界。"
        },
        "projectionRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$"
        },
        "payloadSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "core": {
          "$ref": "#/definitions/Core"
        }
      }
    },
    "Proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "issuerId",
        "keyId",
        "issuedAtMs",
        "expiresAtMs",
        "intent",
        "signature"
      ],
      "properties": {
        "protocol": {
          "const": "sdk2-cache-core-v1"
        },
        "issuerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$"
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$"
        },
        "issuedAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 1
        },
        "intent": {
          "$ref": "#/definitions/Intent"
        },
        "signature": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "Capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "features",
        "limits"
      ],
      "properties": {
        "protocol": {
          "const": "sdk2-cache-core-v1"
        },
        "features": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "enum": [
              "trusted-core-projection-v1",
              "bounded-diagnostics-v1"
            ]
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proofHeaderBytes",
            "materials",
            "diagnosticBytes",
            "responseBytes",
            "diagnosticsPageRows",
            "diagnosticRetentionMs"
          ],
          "properties": {
            "proofHeaderBytes": {
              "const": 8192
            },
            "materials": {
              "const": 8
            },
            "diagnosticBytes": {
              "const": 4096
            },
            "responseBytes": {
              "const": 65536
            },
            "diagnosticsPageRows": {
              "const": 100
            },
            "diagnosticRetentionMs": {
              "const": 86400000
            }
          }
        }
      }
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnosticId",
        "observedAtMs",
        "state",
        "attempts",
        "core",
        "gateway",
        "usage"
      ],
      "properties": {
        "diagnosticId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$"
        },
        "observedAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "accepted",
            "completed",
            "result-unknown"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "core": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "system",
            "tools",
            "materials",
            "materialCount",
            "coverageCount"
          ],
          "properties": {
            "state": {
              "const": "verified"
            },
            "system": {
              "enum": [
                "equal",
                "different",
                "unknown"
              ]
            },
            "tools": {
              "enum": [
                "equal",
                "different",
                "unknown"
              ]
            },
            "materials": {
              "enum": [
                "equal",
                "different",
                "unknown"
              ]
            },
            "materialCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "coverageCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            }
          }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation",
            "commonSegments",
            "totalSegments",
            "firstChangedSegment"
          ],
          "properties": {
            "relation": {
              "enum": [
                "baseline",
                "comparable",
                "not-comparable"
              ]
            },
            "commonSegments": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "totalSegments": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "firstChangedSegment": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 64
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observation",
            "inputTokens",
            "outputTokens",
            "cacheReadTokens",
            "cacheWriteTokens",
            "cacheReadEvidence",
            "cost",
            "currency",
            "savedNet"
          ],
          "properties": {
            "observation": {
              "enum": [
                "unavailable",
                "estimated",
                "reported"
              ]
            },
            "inputTokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "outputTokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "cacheReadTokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "cacheWriteTokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "cacheReadEvidence": {
              "enum": [
                "positive",
                "unknown"
              ]
            },
            "cost": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 128,
                  "pattern": "^-?\\d+(?:\\.\\d+)?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "currency": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                {
                  "type": "null"
                }
              ]
            },
            "savedNet": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 128,
                  "pattern": "^-?\\d+(?:\\.\\d+)?$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "Diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "rows",
        "next"
      ],
      "properties": {
        "protocol": {
          "const": "sdk2-cache-core-v1"
        },
        "rows": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/Diagnostic"
          }
        },
        "next": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 150,
              "pattern": "^[0-9]+\\.[A-Za-z0-9][A-Za-z0-9._~-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
