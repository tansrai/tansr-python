{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tansr.com/contracts/terminal-observation-v1/2026-09-27",
  "title": "终端只读资源与输出关联观察",
  "description": "独立加法合同；关闭请求仍沿原DELETE 202；资源观察不触发关闭或排空。未观测不等于已完成。",
  "definitions": {
    "OutputCorrelation": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/LegacyContract"
        },
        "session": {
          "$ref": "#/definitions/SessionReference"
        },
        "toolCallId": {
          "$ref": "#/definitions/LegacyId"
        },
        "operation": {
          "$ref": "#/definitions/OperationReference"
        },
        "outputAuthority": {
          "enum": [
            "session-events",
            "tool-output"
          ]
        }
      },
      "required": [
        "contract",
        "session",
        "toolCallId",
        "operation",
        "outputAuthority"
      ],
      "additionalProperties": false
    },
    "Contract": {
      "const": "terminal-observation-v1"
    },
    "SessionReference": {
      "type": "object",
      "properties": {
        "sessionContract": {
          "$ref": "#/definitions/SessionContract"
        },
        "sessionId": {
          "$ref": "#/definitions/LegacyId"
        }
      },
      "required": [
        "sessionContract",
        "sessionId"
      ],
      "additionalProperties": false
    },
    "SessionContract": {
      "enum": [
        "sdk1",
        "sdk2-offload-v1"
      ]
    },
    "LegacyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Existing opaque ID; no trimming, case folding or Unicode normalization. Do not mint authority from this string."
    },
    "OperationReference": {
      "type": "object",
      "properties": {
        "operationId": {
          "$ref": "#/definitions/Id"
        },
        "requestDigest": {
          "$ref": "#/definitions/Digest"
        }
      },
      "required": [
        "operationId",
        "requestDigest"
      ],
      "additionalProperties": false
    },
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ErrorCode": {
      "enum": [
        "invalid_request",
        "protocol_version_mismatch",
        "unauthorized",
        "forbidden",
        "not_found",
        "unsupported_capability",
        "capability_unconfirmed",
        "source_unavailable",
        "stale_generation",
        "binding_conflict",
        "revision_conflict",
        "busy",
        "capacity_exceeded",
        "payload_too_large",
        "output_gap",
        "integrity_mismatch",
        "commit_unknown",
        "context_transition_required",
        "request_conflict",
        "request_limit"
      ]
    },
    "Sequence": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
      "maxLength": 19,
      "description": "Canonical unsigned decimal 0..2^63-1. Never parse through IEEE754 Number."
    },
    "ResourceState": {
      "enum": [
        "active",
        "accepted",
        "draining",
        "completed",
        "failed",
        "unknown"
      ]
    },
    "ResourceError": {
      "enum": [
        "close_failed",
        "publication_failed",
        "settlement_failed",
        "settlement_unavailable"
      ]
    },
    "ResourcesResponse": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Contract"
        },
        "session": {
          "$ref": "#/definitions/SessionReference"
        },
        "epochStartSeq": {
          "$ref": "#/definitions/Sequence"
        },
        "state": {
          "$ref": "#/definitions/ResourceState"
        },
        "closeRequested": {
          "type": "boolean"
        },
        "executionEnded": {
          "type": "boolean"
        },
        "errorCode": {
          "anyOf": [
            {
              "$ref": "#/definitions/ResourceError"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "contract",
        "session",
        "epochStartSeq",
        "state",
        "closeRequested",
        "executionEnded",
        "errorCode"
      ],
      "additionalProperties": false
    },
    "CorrelationsResponse": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Contract"
        },
        "session": {
          "$ref": "#/definitions/SessionReference"
        },
        "correlations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OutputCorrelation"
          },
          "maxItems": 32
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "contract",
        "session",
        "correlations",
        "truncated"
      ],
      "additionalProperties": false
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Contract"
        },
        "requestId": {
          "$ref": "#/definitions/Id"
        },
        "code": {
          "$ref": "#/definitions/ErrorCode"
        },
        "status": {
          "enum": [
            400,
            401,
            403,
            404,
            409,
            413,
            429,
            503
          ]
        },
        "retryAction": {
          "enum": [
            "none",
            "discover",
            "refresh",
            "reconcile",
            "backoff"
          ]
        }
      },
      "required": [
        "contract",
        "requestId",
        "code",
        "status",
        "retryAction"
      ],
      "additionalProperties": false
    },
    "LegacyContract": {
      "const": "terminal-services-v1"
    }
  }
}
